# 복사해서 .env로 사용한다. 실제 비밀값은 커밋하지 않는다

# compose.yaml이 MySQL을 노출할 로컬 포트
DB_PORT=3306

# 서버가 사용하는 DB 연결
DB_URL='jdbc:mysql://localhost:3306/teamplespace?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=teamplespace
DB_PASSWORD=teamplespace

# 테스트가 사용하는 DB 연결. 계정은 DB_USERNAME과 DB_PASSWORD를 함께 쓴다
TEST_DB_URL='jdbc:mysql://localhost:3306/teamplespace_test?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'

# 인증을 사용하려면 32자 이상의 별도 비밀키와 서비스 주소를 설정한다
AUTH_SECRET=
FRONTEND_ORIGIN=
BACKEND_ORIGIN=
AUTH_SECURE_COOKIE=true

# SMTP 설정. 개발 환경에서도 인증 코드는 메일로만 보낸다
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=

# 실제 공개 약관의 주소와 버전이 없으면 가입 완료를 막는다
TERMS_VERSION=
TERMS_URL=
PRIVACY_VERSION=
PRIVACY_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
